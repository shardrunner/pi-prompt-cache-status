      "brace-expansion": "5.0.12",
      "undici": "8.12.3"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.0",
    "@earendil-works/pi-coding-agent": "0.99.0",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  }
