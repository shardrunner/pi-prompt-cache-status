  "description": "Cross-provider cache-usage observations and an inactivity reminder for pi, without replacing its footer.",
  "license": "MIT",
  "author": "Michael Brunner",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "keywords": ["pi-package", "pi", "codex", "prompt-cache"],
